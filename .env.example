# ── Supabase（第 2 步：supabase.com 新建项目后从 Project Settings → API 复制）──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # 机密，仅服务端使用，切勿泄露

# ── 虎皮椒支付（第 3 步：虎皮椒/迅虎商户后台获取）──
XUNHU_APPID=
XUNHU_APPSECRET=                    # 机密
# 可选：自定义下单接口地址（不填用代码默认值）
# XUNHU_API_URL=

# ── 后台管理员（邮箱白名单）──
# 列出可进 /admin 的邮箱（逗号分隔可多个）。这些邮箱用「邮箱验证码登录」
# 登录后即拥有后台权限，无需密码。OTP/SMTP 在 Supabase 后台配置。
ADMIN_EMAILS=you@example.com

# ── 站点公网域名（部署后填线上域名；本地可填 http://localhost:3000）──
# 自动发卡依赖虎皮椒异步回调，localhost 无法被回调——发卡只在线上生效
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Cloudflare Turnstile 人机验证（可选，登录页「获取验证码」前拦截机器人）──
# dash.cloudflare.com → Turnstile → Add widget，Hostname 填 cngptplus.shop（再加 localhost）
# 两个 key 都填上才启用；留空则跳过人机验证（不影响登录）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=     # 公开，前端 widget 用
TURNSTILE_SECRET_KEY=               # 机密，仅服务端验签用

# ── 运营告警 webhook（可选，「已付但缺货」时推送到你会看的地方）──
# 填 Server酱(sctapi.ftqq.com/<KEY>.send) 或 PushPlus 等接收表单 title+desp 的地址
# 留空则只写服务端日志，不推送
ALERT_WEBHOOK_URL=

# ── Telegram 补货/缺货提醒（可选，推荐）──
# @BotFather 建机器人拿 token；给机器人发一句话后用 getUpdates 拿你的 chat_id
# 两个都填才启用。⚠️ 大陆机房 VPS 出站到 api.telegram.org 会被墙，请先 curl 验证
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Telegram 远程补货（可选，需要上面两项已配置）──
# 给机器人发 /add 直接补卡密（见 README「TG 远程补货」）。webhook 验签密钥，
# 自己生成一串随机值（openssl rand -hex 32），注册 webhook 时要用同一个值。
# 只在公网部署（Vercel）生效；不注册 webhook 则此功能完全关闭。
TELEGRAM_WEBHOOK_SECRET=

# ── 飞书告警（可选，大陆环境推荐；Telegram 的替代品）──
# 群设置 → 添加机器人 → 自定义机器人，复制 webhook 地址。纯出站请求，
# 大陆 VPS 也打得通。只想要告警的话，配这一项就够了，不用建应用。
FEISHU_WEBHOOK_URL=
# 若群机器人勾了「签名校验」，把它给的密钥填这里；没勾就留空
FEISHU_WEBHOOK_SECRET=              # 机密

# ── 飞书运营机器人（可选：订单通知、查库存、补货、改价）──
# open.feishu.cn → 开发者后台 → 创建企业自建应用，然后：
#   1. 凭证与基础信息 → 拿 App ID / App Secret
#   2. 权限管理 → 开通 im:message.group_at_msg:readonly、
#                    im:message:send_as_bot、im:message:recall
#   3. 事件与回调 → 请求地址填 https://<你的域名>/api/feishu
#                 → 拿 Verification Token 和 Encrypt Key（建议开启加密）
#                 → 添加事件「接收消息 im.message.receive_v1」
#   4. 把机器人拉进一个群，用「@机器人 /list」试一下；
#      FEISHU_CHAT_ID 从开放平台事件日志的 event.message.chat_id 获取
# 启用前必须依次执行：
#   supabase/migrations/20260814_feishu_restock_hardening.sql
#   supabase/migrations/20260814_feishu_orders_and_price.sql
# ⚠️ 补货请在群里做并把机器人设为群主，否则它撤回不了你粘贴的卡密消息。
FEISHU_APP_ID=
FEISHU_APP_SECRET=                  # 机密
FEISHU_VERIFICATION_TOKEN=          # 机密
FEISHU_ENCRYPT_KEY=                 # 机密，事件订阅开了加密才需要
FEISHU_CHAT_ID=                     # 只有这个会话能执行命令，订单通知也发到这里
